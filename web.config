<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Core security and directory configurations -->
    <webSocket enabled="false" />
    <handlers>
      <!-- Explicitly tells IIS to pass requests hitting server.js to the iisnode module -->
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>
    
    <rewrite>
      <rules>
        <!-- Do not interfere with Node-inspector debugging if enabled -->
        <rule name="NodeInspector" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^server.js\/debug[\/]?" />
        </rule>

        <!-- Static content shortcut: if files exist in your folder, let IIS serve them fast -->
        <rule name="StaticContent">
          <action type="Rewrite" url="public{REQUEST_URI}"/>
        </rule>

        <!-- All other URLs are mapped to your Node.js entry point -->
        <rule name="DynamicContent" stopProcessing="true">
          <match url="/*" />
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- Prevents users from browsing your backend codebase directories -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <remove segment="bin"/>
          <add segment="node_modules"/>
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!-- Ensures friendly error details show up if node crashes internally -->
    <httpErrors errorMode="Detailed" />
    
  </system.webServer>
</configuration>
